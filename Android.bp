soong_namespace {
}

// ==========================================================
// --- SECTION 1: Dolby Atmos & Audio (Multilib) ---
// ==========================================================

cc_prebuilt_library_shared {
    name: "libdlbpreg",
    owner: "xiaomi",
    strip: { none: true },
    target: {
        android_arm: { srcs: ["proprietary/vendor/lib/libdlbpreg.so"] },
        android_arm64: { srcs: ["proprietary/vendor/lib64/libdlbpreg.so"] },
    },
    [span_2](start_span)// Fix for DT_NEEDED "libstagefright_foundation-v33.so" error[span_2](end_span)
    shared_libs: ["libaudioutils", "libc++", "libcutils", "liblog", "libstagefright_foundation-v33", "libutils"],
    compile_multilib: "both",
    check_elf_files: false,
    prefer: true,
    soc_specific: true,
}

cc_prebuilt_library_shared {
    name: "libstagefrightdolby",
    owner: "xiaomi",
    strip: { none: true },
    target: {
        android_arm: { srcs: ["proprietary/vendor/lib/libstagefrightdolby.so"] },
        android_arm64: { srcs: ["proprietary/vendor/lib64/libstagefrightdolby.so"] },
    },
    // Dependency fix: libstagefright_foundation-v33 and correct softomx name
    shared_libs: ["libc++", "liblog", "libstagefright_foundation-v33", "libstagefright_softomx", "libutils"],
    compile_multilib: "both",
    check_elf_files: false,
    prefer: true,
    soc_specific: true,
}

