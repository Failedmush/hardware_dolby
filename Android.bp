// Combined Dolby Atmos (v33 Foundation) & Dolby Vision (Standard Foundation)

soong_namespace {
}

// --- Dolby Atmos & Audio (Multilib / v33 Foundation) ---

cc_prebuilt_library_shared {
    name: "libdlbpreg",
    owner: "xiaomi",
    strip: { none: true },
    target: {
        android_arm: { srcs: ["proprietary/vendor/lib/libdlbpreg.so"] },
        android_arm64: { srcs: ["proprietary/vendor/lib64/libdlbpreg.so"] },
    },
    // Atmos specifically requires v33 foundation per logs
    shared_libs: [
        "libaudioutils", 
        "libc++", 
        "libcutils", 
        "liblog", 
        "libstagefright_foundation-v33", 
        "libutils"
    ],
    compile_multilib: "both",
    check_elf_files: false, // Bypass strict v33 check per log suggestion
    prefer: true,
    soc_specific: true,
}

cc_prebuilt_library_shared {
    name: "libstagefrightdolby",
    owner: "xiaomi",
    strip: { none: true },
    target: {
        android_arm: { srcs: ["proprietary/vendor/lib/libstagefrightdolby.so"] },
        android_arm64: { srcs: ["proprietary/vendor/lib64/libstagefrightdolby.so"] },
    },
    // Atmos specifically requires v33 foundation per logs
    shared_libs: [
        "libc++", 
        "liblog", 
        "libstagefright_foundation-v33", 
        "libstagefright_softomx", 
        "libutils"
    ],
    compile_multilib: "both",
    check_elf_files: false, // Bypass strict v33 check
    prefer: true,
    soc_specific: true,
}

cc_prebuilt_library_shared {
    name: "libdlbvol",
    owner: "xiaomi",
    strip: { none: true },
    target: {
        android_arm: { srcs: ["proprietary/vendor/lib/soundfx/libdlbvol.so"] },
        android_arm64: { srcs: ["proprietary/vendor/lib64/soundfx/libdlbvol.so"] },
    },
    shared_libs: [
        "liblog", 
        "libutils", 
        "libcutils", 
        "libaudioutils", 
        "libstagefright_foundation-v33", 
        "libdlbpreg", 
        "vendor.dolby.hardware.dms@2.0", 
        "libc++"
    ],
    compile_multilib: "both",
    relative_install_path: "soundfx",
    check_elf_files: false,
    prefer: true,
    soc_specific: true,
}

cc_prebuilt_library_shared {
    name: "vendor.dolby.hardware.dms@2.0",
    owner: "xiaomi",
    strip: { none: true },
    target: {
        android_arm: { srcs: ["proprietary/vendor/lib/vendor.dolby.hardware.dms@2.0.so"] },
        android_arm64: { srcs: ["proprietary/vendor/lib64/vendor.dolby.hardware.dms@2.0.so"] },
    },
    shared_libs: ["libhidlbase", "liblog", "libutils", "libcutils", "libc++", "libc", "libm", "libdl"],
    compile_multilib: "both",
    prefer: true,
    soc_specific: true,
}

// --- Dolby Vision / Codec2 (32-bit Only / Standard Foundation) ---

cc_prebuilt_library_shared {
    name: "c2.dolby.avc.dec",
    owner: "xiaomi",
    target: { android_arm: { srcs: ["proprietary/vendor/lib/c2.dolby.avc.dec.so"] } },
    // Using standard libstagefright_foundation for Vision
    shared_libs: [
        "android.hardware.media.c2@1.0", "c2.dolby.client", "c2.dolby.store", 
        "libbase", "libc++", "libcodec2", "libcodec2_hidl@1.0", "libcodec2_soft_common", 
        "libcodec2_vndk", "libcutils", "libdovi", "liblog", "libsfplugin_ccodec_utils", 
        "libstagefright_bufferpool@2.0.1", "libstagefright_foundation", "libutils"
    ],
    compile_multilib: "32",
    check_elf_files: false,
    prefer: true,
    soc_specific: true,
}

cc_prebuilt_library_shared {
    name: "c2.dolby.hevc.dec",
    owner: "xiaomi",
    target: { android_arm: { srcs: ["proprietary/vendor/lib/c2.dolby.hevc.dec.so"] } },
    // Using standard libstagefright_foundation for Vision
    shared_libs: [
        "android.hardware.media.c2@1.0", "c2.dolby.client", "c2.dolby.store", 
        "libbase", "libc++", "libcodec2", "libcodec2_hidl@1.0", "libcodec2_soft_common", 
        "libcodec2_vndk", "libcutils", "libdovi", "liblog", "libsfplugin_ccodec_utils", 
        "libstagefright_bufferpool@2.0.1", "libstagefright_foundation", "libutils"
    ],
    compile_multilib: "32",
    check_elf_files: false,
    prefer: true,
    soc_specific: true,
}

cc_prebuilt_library_shared {
    name: "libdovi",
    owner: "xiaomi",
    target: { android_arm: { srcs: ["proprietary/vendor/lib/libdovi.so"] } },
    shared_libs: [
        "android.hardware.media.c2@1.0", "c2.dolby.egl", "libEGL", "libGLESv2", 
        "libbase", "libc++", "libcodec2", "libcodec2_hidl@1.0", "libcodec2_vndk", 
        "libcutils", "libdolbyottcameracontrol", "libhidlbase", "liblog", 
        "libstagefright_foundation", "libui", "libutils"
    ],
    compile_multilib: "32",
    prefer: true,
    soc_specific: true,
}

cc_prebuilt_binary {
    name: "dolbycodec2",
    owner: "xiaomi",
    target: { android_arm: { srcs: ["proprietary/vendor/bin/hw/dolbycodec2"] } },
    shared_libs: [
        "android.hardware.media.c2@1.0", "c2.dolby.store", "libavservices_minijail_vendor", 
        "libbinder", "libc++", "libcodec2_hidl@1.0", "libhidlbase", "liblog", 
        "libstagefright_foundation", "libutils"
    ],
    compile_multilib: "32",
    relative_install_path: "hw",
    prefer: true,
    soc_specific: true,
}

prebuilt_etc_xml {
    name: "c2_manifest_vendor.xml",
    src: "proprietary/vendor/etc/vintf/manifest/c2_manifest_vendor.xml",
    sub_dir: "vintf/manifest",
    soc_specific: true,
}
